{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "api/src",
    "baseUrl": "api/src",
    "typeRoots": ["./node_modules/@types", "api/src/types"]
  }
}
